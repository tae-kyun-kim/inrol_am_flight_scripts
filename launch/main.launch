<?xml version="1.0"?>
<launch>
  <arg name="fcu_url" default="/dev/ttyPixhawk:921600"/>
  <arg name="gcs_url" default="udp://:14550@127.0.0.1:14557"/>
  <arg name="env_path" default="/home/inrol/.local/share/am/env.sh"/>

  <machine
    name="agent-a"
    address="inrol-am-a.local"
    env-loader="$(arg env_path)"
    default="never"
    user="inrol"/>

  <include file="$(dirname)/mavros.launch">
    <arg name="fcu_url" value="$(arg fcu_url)"/>
    <arg name="gcs_url" value="$(arg gcs_url)"/>
    <arg name="machine" value="agent-a"/>
    <arg name="namespace" value="agent1"/>
  </include>

  <include file="$(dirname)/optitrack.launch">
    <arg name="machine" value="agent-a"/>
    <arg name="server" value="192.168.100.47"/>
  </include>
</launch>

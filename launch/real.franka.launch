<?xml version="1.0" ?>
<launch>
  <arg name="robot" default="panda"/>
  <arg name="arm_id" default="$(arg robot)" />
  <arg name="load_gripper" default="false"/>
  <arg name="xacro_args" default="" />
  <arg name="robot_ip" default="172.16.2.1"/>
  <arg name="ftsensor_ip" default="192.168.10.27"/>

  <arg name="env_path" default="/home/inrol/.local/share/door/env.sh"/>

  <machine
    name="franka-nuc"
    address="inrol-franka-a.local"
    env-loader="$(arg env_path)"
    default="never"
    user="inrol"/>

  <param name="robot_description" command="$(find xacro)/xacro $(find franka_description)/robots/$(arg robot)/$(arg robot).urdf.xacro hand:=$(arg load_gripper) arm_id:=$(arg arm_id) $(arg xacro_args)"/>

  <node name="franka_control" pkg="franka_control" type="franka_control_node" output="log" required="true" ns="panda" machine="franka-nuc">
    <rosparam command="load" file="$(find inrol_am_teleoperation)/config/real.franka_control.yaml" subst_value="true" />
    <param name="robot_ip" value="$(arg robot_ip)" />
  </node>

  <rosparam command="load" file="$(find inrol_am_teleoperation)/config/real.config.yaml" ns="panda"/>
  <node name="controller_spawner" pkg="controller_manager" type="spawner" ns="panda" machine="franka-nuc"
    respawn="false" output="log" args="inrol_am_franka_teleoperation">
  </node>

  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" machine="franka-nuc">
    <remap from="joint_states" to="/panda/master/joint/state"/>
  </node>

  <node name="netft_node" pkg="netft_utils" type="netft_node"
    args="--address $(arg ftsensor_ip)" output="log" machine="franka-nuc">
    <remap from="netft_data" to="panda/master/tool/wrench/data"/>
    <remap from="netft_status" to="panda/master/tool/wrench/status"/>
  </node>

  <node name="rviz" pkg="rviz" type="rviz"
    args="-d $(find inrol_am_teleoperation)/launch/rviz.rviz"/>

  <node name="world_link0_tf" pkg="tf" type="static_transform_publisher" machine="franka-nuc"
    args="0 0 0 0 0 1 0 world panda_link0 100"/>

  <node name="link8_tool_tf" pkg="tf" type="static_transform_publisher" machine="franka-nuc"
    args="0 0 0.1 0 1 0 0 panda_link8 panda_tool 100"/>

  <node name="map_world_tf" pkg="tf" type="static_transform_publisher" machine="franka-nuc"
    args="0 -1 0 0 0 0 1 map world 100"/>
</launch>

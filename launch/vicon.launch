<?xml version="1.0"?>
<launch>
  <arg name="machine"/>
  <arg name="datastream_hostport"/>

  <node machine="$(arg machine)"
    pkg="vicon_bridge"
    type="vicon_bridge"
    name="vicon_bridge"
    output="screen">
    <param name="stream_mode" value="ServerPush"/>
    <param name="datastream_hostport" value="$(arg datastream_hostport)"/>
    <param name="tf_ref_frame_id" value="map"/>
    <remap from="vicon/AM/AM" to="mavros/vision_pose/pose"/>
  </node>
</launch>

